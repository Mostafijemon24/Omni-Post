# Copy to .env.local for local development, or set these in your host's environment settings.
# Never commit real values.

# Supabase → Project Settings → API. The service-role key is secret: server only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter → Keys. OPENROUTER_MODEL is the default when the Studio sends none.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Owner login for the dashboard and for approving MCP connectors (Claude, ChatGPT, …).
OMNIPOST_ADMIN_PASSWORD=
# Random string, at least 32 characters, signs login cookies. e.g. `openssl rand -base64 48`
OMNIPOST_SECRET=

# Public URL of this deployment, no trailing slash. MCP endpoint = $PUBLIC_BASE_URL/mcp
PUBLIC_BASE_URL=https://post.avonixai.com
